<Project>
  <PropertyGroup>
    <!-- WinForms designer-serialization analyzer (new in .NET 9+); noise for legacy forms.
         Lives in .targets so it is appended after project-level NoWarn overrides. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'windows'">
    <!-- Consumed by VersionInfo.cs to emit [assembly: SupportedOSPlatform("windows")] only for Windows-only projects. -->
    <DefineConstants>$(DefineConstants);MP2_WINDOWS_TFM</DefineConstants>
  </PropertyGroup>
</Project>
