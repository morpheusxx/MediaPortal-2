/*
** Used by Rendering.ImageContext
** This is a simple shader used for rendering images when no additional effects or transformations are applied.
*/

uniform float g_opacity;
uniform float4x4 g_relativetransform;
uniform float4 g_imagetransform;
uniform float4 g_framedata;

half4 main(float2 uv)
{
  // Apply relative transform
  float2 pos = (g_relativetransform * float4(uv.x, uv.y, 0.0, 1.0)).xy;
  // Transform vertex coords to place brush texture
  float2 texcoord = pos * g_imagetransform.zw - g_imagetransform.xy;

  float4 color = SampleBorder(texcoord);
  color.a *= g_opacity;
  // Remember to pre-multiply alpha
  return half4(Premul(color));
}
