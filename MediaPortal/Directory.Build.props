<Project>
  <PropertyGroup>
    <!-- Allow building net10.0-windows projects on non-Windows hosts (e.g. Linux CI) until they are split off. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Platform compatibility analyzer (CA1416) is the work list for the cross-platform rework. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
</Project>
