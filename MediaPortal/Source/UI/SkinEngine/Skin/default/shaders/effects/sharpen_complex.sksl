/*
 * A more complex image sharpening effect.
 *
 * Original shader source: MPC-HC (http://mpc-hc.sourceforge.net/)
*/
const float CenterBias = 2.0;
const float SampleBias = 0.125;

float4 PixelEffect(float2 texcoord, int which, float4 framedata)
{
  float dx = 1.0 / framedata.x;
  float dy = 1.0 / framedata.y;

  // The matrix of 9 points
  // [ 1, 2 , 3 ]
  // [ 4,ori, 5 ]
  // [ 6, 7 , 8 ]
  float4 ori = SampleWhich(which, texcoord);
  float4 c1 = SampleWhich(which, texcoord + float2(-dx, -dy));
  float4 c2 = SampleWhich(which, texcoord + float2(0.0, -dy));
  float4 c3 = SampleWhich(which, texcoord + float2(dx, -dy));
  float4 c4 = SampleWhich(which, texcoord + float2(-dx, 0.0));
  float4 c5 = SampleWhich(which, texcoord + float2(dx, 0.0));
  float4 c6 = SampleWhich(which, texcoord + float2(-dx, dy));
  float4 c7 = SampleWhich(which, texcoord + float2(0.0, dy));
  float4 c8 = SampleWhich(which, texcoord + float2(dx, dy));

  // Gaussian blur, normalized by the sum of the coefficients (1/16)
  float4 flou = (c1 + c3 + c6 + c8 + 2.0 * (c2 + c4 + c5 + c7) + 4.0 * ori) * 0.0625;

  // Subtract the blurred image from the original
  float4 cori = 2.0 * ori - flou;

  // Edge detection with sobel filter
  float4 delta1 = (c3 + 2.0 * c5 + c8) - (c1 + 2.0 * c4 + c6);
  float4 delta2 = (c6 + 2.0 * c7 + c8) - (c1 + 2.0 * c2 + c3);
  float value = sqrt(dot(delta1, delta1) + dot(delta2, delta2));

  if (value > 0.3)
    return ori * CenterBias - (c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8) * SampleBias; // Edge, sharpen
  return cori;
}
