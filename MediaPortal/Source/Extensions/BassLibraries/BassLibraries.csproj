<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>MediaPortal.Extensions.BassLibraries</RootNamespace>
    <OldToolsVersion>3.5</OldToolsVersion>
    <SolutionDir Condition="$(SolutionDir) == '' Or $(SolutionDir) == '*Undefined*'">..\..\</SolutionDir>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup>
    <!--required for assemblies from nuget packages to be copied to output folder, so our build.targets can copy them further -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Core\MediaPortal.Common\VersionInfo\VersionInfo.cs">
      <Link>Properties\VersionInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="plugin.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\MediaPortal.Common\MediaPortal.Common.csproj" />
    <ProjectReference Include="..\..\Core\MediaPortal.Utilities\MediaPortal.Utilities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="build.targets">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- Native Windows libraries (bass.dll, add-ins, ...) -->
    <PackageReference Include="BASSCombined">
      <Version>2.4.15</Version>
    </PackageReference>
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Mix" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Wasapi" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Cd" Version="4.0.2" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Native libraries of Linux and macOS: package MediaPortal.Native.Bass (Build\native\bass). Until it is published on the Team MediaPortal feed it can be created locally
         with build-package.py; it is then found in the folder "feed". Set -p:UseBassNativePackage=true to require it (CI). -->
    <BassNativeVersion>2.4.0.20261022</BassNativeVersion>
    <BassPackageFeed>$(MSBuildThisFileDirectory)..\..\..\Build\native\bass\feed</BassPackageFeed>
    <UseBassNativePackage Condition="'$(UseBassNativePackage)' == '' And Exists('$(BassPackageFeed)\MediaPortal.Native.Bass.$(BassNativeVersion).nupkg')">true</UseBassNativePackage>
    <RestoreAdditionalProjectSources Condition="Exists('$(BassPackageFeed)')">$(RestoreAdditionalProjectSources);$(BassPackageFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseBassNativePackage)' == 'true'">
    <PackageReference Include="MediaPortal.Native.Bass" Version="$(BassNativeVersion)" GeneratePathProperty="true" ExcludeAssets="native;runtime;compile" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="build.targets" />
</Project>