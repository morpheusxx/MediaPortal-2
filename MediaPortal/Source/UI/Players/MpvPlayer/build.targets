<Project>

  <Target Name="CopyToOutput" AfterTargets="Build" Condition="'$(IsCrossTargetingBuild)' != 'true'">

    <PropertyGroup>
      <PluginDestination>$(SolutionDir)..\Bin\$(SolutionName)\$(OutDir)Plugins\$(ProjectName)\</PluginDestination>
    </PropertyGroup>

    <ItemGroup>
      <PluginFiles Include="$(TargetDir)$(ProjectName).dll" />
      <PluginFiles Include="$(ProjectDir)plugin.xml" />
    </ItemGroup>

    <ItemGroup>
      <LanguageFiles Include="$(ProjectDir)Language\*.*" />
    </ItemGroup>

    <!-- libmpv comes with the NuGet package MediaPortal.Native.Mpv (see Build\native\mpv\build-package.py). The property MpvNativeDir can point
         to a folder with another libmpv-2.dll (for example a newer build) instead. On Linux the system package (libmpv2) is used. -->
    <PropertyGroup>
      <MpvNativeDir Condition="'$(MpvNativeDir)' == '' And '$(PkgMediaPortal_Native_Mpv)' != ''">$(PkgMediaPortal_Native_Mpv)\runtimes\win-x64\native\</MpvNativeDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(MpvNativeDir)' != '' And Exists('$(MpvNativeDir)libmpv-2.dll')">
      <MpvNativeFiles Include="$(MpvNativeDir)libmpv-2.dll" />
    </ItemGroup>
    <Message Importance="high" Text="MpvPlayer: libmpv-2.dll not found, video playback on Windows won't work (package MediaPortal.Native.Mpv not restored, see MpvPlayer.csproj)" Condition="'@(MpvNativeFiles)' == '' And $([MSBuild]::IsOSPlatform('Windows'))" />

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginDestination)" />
    <Copy SourceFiles="@(MpvNativeFiles)" DestinationFolder="$(PluginDestination)runtimes\win-x64\native\" Condition="'@(MpvNativeFiles)' != '' And $([MSBuild]::IsOSPlatform('Windows'))" />
    <Copy SourceFiles="@(LanguageFiles)" DestinationFolder="$(PluginDestination)Language\" />
  </Target>

</Project>
