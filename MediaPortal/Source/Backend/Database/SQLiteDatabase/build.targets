<Project>

  <Target Name="CopyToOutput" AfterTargets="Build" Condition="'$(IsCrossTargetingBuild)' != 'true'">

    <PropertyGroup>
      <PluginDestination>$(SolutionDir)..\Bin\$(SolutionName)\$(OutDir)Plugins\$(ProjectName)\</PluginDestination>
    </PropertyGroup>

    <ItemGroup>
      <PluginFiles Include="$(TargetDir)$(ProjectName).dll" />
      <PluginFiles Include="$(ProjectDir)plugin.xml" />
    </ItemGroup>

    <ItemGroup Condition=" '$(Configuration)' == 'Debug'">
      <PluginFiles Include="$(TargetDir)$(ProjectName).pdb" />
    </ItemGroup>

    <ItemGroup>
      <References Include="$(TargetDir)Microsoft.Data.Sqlite.dll" />
      <References Include="$(TargetDir)SQLitePCLRaw.*.dll" />
    </ItemGroup>

    <!-- Native SQLite builds for all platforms. SQLiteDatabase resolves the one matching the current runtime from runtimes\<rid>\native. -->
    <ItemGroup>
      <SQLiteNative Include="$(TargetDir)runtimes\**\native\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginDestination)" />
    <Copy SourceFiles="@(References)" DestinationFolder="$(PluginDestination)" />
    <Copy SourceFiles="@(SQLiteNative)" DestinationFiles="@(SQLiteNative->'$(PluginDestination)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
