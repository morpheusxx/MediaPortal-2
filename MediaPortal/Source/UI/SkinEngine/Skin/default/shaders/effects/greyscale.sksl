/*
 * A simple greyscale effect
 *
 * Original shader source: MPC-HC (http://mpc-hc.sourceforge.net/)
*/
float4 PixelEffect(float2 texcoord, int which, float4 framedata)
{
  float4 color = SampleWhich(which, texcoord);
  float luminance = dot(color, float4(0.299, 0.587, 0.114, 0.0));
  return float4(luminance, luminance, luminance, color.a);
}
